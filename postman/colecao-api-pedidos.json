{
  "info": {
    "_postman_id": "ac44c0a6-df42-4d2f-9e2b-d13b80b5e4b0",
    "name": "API de Gerenciamento de Pedidos",
    "description": "Coleção para testar os endpoints do projeto avaliativo. Inicie a API em localhost:3000 antes de executar.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "pedidoId", "value": "1" }
  ],
  "item": [
    {
      "name": "01 - Criar pedido válido (201)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"cliente\": \"Carlos Silva\",\n  \"tipo\": \"entrega\",\n  \"valor\": 350,\n  \"prioridade\": \"normal\"\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/pedidos"
      }
    },
    {
      "name": "02 - Validar cliente vazio (400)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"cliente\": \"   \",\n  \"tipo\": \"entrega\",\n  \"valor\": 350,\n  \"prioridade\": \"normal\"\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/pedidos"
      }
    },
    {
      "name": "03 - Listar pedidos (200)",
      "request": { "method": "GET", "url": "{{baseUrl}}/pedidos" }
    },
    {
      "name": "04 - Consultar ID inexistente (404)",
      "request": { "method": "GET", "url": "{{baseUrl}}/pedidos/999" }
    },
    {
      "name": "05 - Atualizar status para em_preparacao (200; precisa existir pedido 1)",
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"status\": \"em_preparacao\"\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/pedidos/{{pedidoId}}/status"
      }
    }
  ]
}
